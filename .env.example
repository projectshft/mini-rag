# --- OpenAI ---
# If we minted you a CLASS API KEY, use it here and set OPENAI_BASE_URL below.
# Using your own OpenAI account instead? Put your sk-... key here and leave
# OPENAI_BASE_URL commented out.
OPENAI_API_KEY=your_openai_api_key_here

# Class key only. Routes both SDKs through the class proxy. Leave this unset
# if you're on your own OpenAI account.
# OPENAI_BASE_URL=https://parsity-litellm.fly.dev/v1

# --- Pinecone (always your own account — the free tier is enough) ---
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_index_name_here
