# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Only set this if you were given a class API key — it points both SDKs at the
# class proxy. Using your own OpenAI account? Leave it unset.
OPENAI_BASE_URL=

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_index_name_here
